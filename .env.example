# ScamGraph AI - Environment Configuration Example

# Application
APP_NAME=ScamGraph AI
DEBUG=false
API_V1_STR=/api/v1

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite:///data/scamgraph_v2.db

# TinyFish Public Web Intelligence API
# Obtain credentials from your configured TinyFish endpoint
TINYFISH_API_KEY=YOUR_TINYFISH_API_KEY
TINYFISH_API_BASE_URL=https://api.tinyfish.io/v1
TINYFISH_ENABLED=false
TINYFISH_TIMEOUT_SECONDS=10
TINYFISH_MAX_RETRIES=2

# Optional AI LLM Explanation Providers
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
AI_MODEL_NAME=rule-engine-v2
