# ScamGraph AI - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_NAME=ScamGraph AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_PATH=data/scamgraph.db

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME_BASE=dark

# Gmail API (Future Integration)
# GMAIL_CLIENT_ID=your_client_id
# GMAIL_CLIENT_SECRET=your_client_secret
# GMAIL_REDIRECT_URI=http://localhost:8501/callback

# AI/ML Models (Future Integration)
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# TinyFish Research API (Future Integration)
# TINYFISH_API_KEY=your_tinyfish_key

# Security
SECRET_KEY=your-secret-key-change-in-production
SESSION_TIMEOUT_MINUTES=60